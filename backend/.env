# ================================================
# VARIABLES DE ENTORNO - SISTEMA OVT
# Renombra este archivo a .env y completa los valores
# ================================================

# Puerto del servidor
PORT=3001

# Secreto para JWT (cambiar a algo único y seguro)
JWT_SECRET=tu-secreto-super-seguro-cambia-esto-en-produccion-12345

# Firebase Configuration
# Obtener estos valores de Firebase Console -> Project Settings
FIREBASE_PROJECT_ID=tu-proyecto-firebase
FIREBASE_PRIVATE_KEY=tu-private-key-firebase
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@tu-proyecto.iam.gserviceaccount.com
FIREBASE_DATABASE_URL=https://tu-proyecto.firebaseio.com

# O directamente el archivo JSON completo en base64
# Generar con: cat service-account-key.json | base64 -w 0
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"..."}

# Node Environment
NODE_ENV=production

# CORS - URLs permitidas
CORS_ORIGIN=*

# Base de datos
FIRESTORE_EMULATOR_HOST=localhost:8080  # Solo para desarrollo local
